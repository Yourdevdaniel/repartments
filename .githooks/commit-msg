#!/bin/sh
# Apaga da mensagem as linhas de coautoria e de sessão, e recusa o commit
# se o autor não for Daniel <akirazcs@gmail.com>.
# Ligar uma vez em cada clone: git config core.hooksPath .githooks
msg="$1"
tmp="$msg.tmp"
grep -viE '^(Co-Authored-By|[A-Za-z]+-Session):' "$msg" > "$tmp" || true
mv "$tmp" "$msg"

autor=$(git var GIT_AUTHOR_IDENT | sed 's/ [0-9]* [-+][0-9]*$//')
if [ "$autor" != "Daniel <akirazcs@gmail.com>" ]; then
  echo "Commit recusado: o autor é \"$autor\", e deve ser Daniel <akirazcs@gmail.com>." >&2
  echo "Rode: git config user.name Daniel && git config user.email akirazcs@gmail.com" >&2
  exit 1
fi
